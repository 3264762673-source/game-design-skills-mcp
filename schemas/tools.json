  {
    "name": "validate_decision_card",
    "title": null,
    "description": "Validate the eight-field decision card and evidence presence; not evidence truth.",
    "inputSchema": {
      "$defs": {
        "DecisionCard": {
          "additionalProperties": false,
          "properties": {
            "trigger": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Trigger",
              "type": "string"
            },
            "hypotheses": {
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "minItems": 1,
              "title": "Hypotheses",
              "type": "array"
            },
            "check": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Check",
              "type": "string"
            },
            "change": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Change",
              "type": "string"
            },
            "exclusions": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Exclusions",
              "type": "string"
            },
            "expected": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Expected",
              "type": "string"
            },
            "rollback": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Rollback",
              "type": "string"
            },
            "sources": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "minItems": 1,
              "title": "Sources",
              "type": "array"
            },
            "status": {
              "default": "hypothesis",
              "enum": [
                "hypothesis",
                "observed",
                "compared"
              ],
              "title": "Status",
              "type": "string"
            },
            "evidence": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Evidence",
              "type": "array"
            }
          },
          "required": [
            "trigger",
            "hypotheses",
            "check",
            "change",
            "exclusions",
            "expected",
            "rollback",
            "sources"
          ],
          "title": "DecisionCard",
          "type": "object"
        }
      },
      "properties": {
        "card": {
          "$ref": "#/$defs/DecisionCard"
        }
      },
      "required": [
        "card"
      ],
      "title": "validate_decision_cardArguments",
      "type": "object"
    },
    "outputSchema": null,
    "icons": null,
    "annotations": null,
    "meta": null,
    "execution": null
  },
  {
