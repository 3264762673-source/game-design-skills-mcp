  {
    "name": "create_effect_bundle",
    "title": null,
    "description": "Return runnable Canvas impact/burst/pulse code and validated bounded configuration.",
    "inputSchema": {
      "$defs": {
        "EffectSpec": {
          "additionalProperties": false,
          "properties": {
            "effect": {
              "default": "impact",
              "enum": [
                "impact",
                "burst",
                "pulse"
              ],
              "title": "Effect",
              "type": "string"
            },
            "duration_ms": {
              "default": 240,
              "maximum": 2000,
              "minimum": 40,
              "title": "Duration Ms",
              "type": "integer"
            },
            "radius_px": {
              "default": 36,
              "maximum": 160,
              "minimum": 1,
              "title": "Radius Px",
              "type": "number"
            },
            "particles": {
              "default": 12,
              "maximum": 48,
              "minimum": 0,
              "title": "Particles",
              "type": "integer"
            },
            "color": {
              "default": "#65d6ff",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "title": "Color",
              "type": "string"
            },
            "reduced_motion": {
              "default": false,
              "title": "Reduced Motion",
              "type": "boolean"
            }
          },
          "title": "EffectSpec",
          "type": "object"
        }
      },
      "properties": {
        "spec": {
          "$ref": "#/$defs/EffectSpec"
        }
      },
      "required": [
        "spec"
      ],
      "title": "create_effect_bundleArguments",
      "type": "object"
    },
    "outputSchema": null,
    "icons": null,
    "annotations": null,
    "meta": null,
    "execution": null
  },
  {
    "name": "calculate_combat",
    "title": null,
    "description": "Calculate deterministic subtractive damage, hit count and TTK in seconds.",
    "inputSchema": {
      "$defs": {
        "CombatSpec": {
          "additionalProperties": false,
          "properties": {
            "hp": {
              "exclusiveMinimum": 0,
              "maximum": 1000000000000.0,
              "title": "Hp",
              "type": "number"
            },
            "attack": {
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0,
              "title": "Attack",
              "type": "number"
            },
            "defense": {
              "default": 0,
              "maximum": 1000000000.0,
              "minimum": 0,
              "title": "Defense",
              "type": "number"
            },
            "multiplier": {
              "default": 1,
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "title": "Multiplier",
              "type": "number"
            },
            "minimum_damage": {
              "default": 1,
              "exclusiveMinimum": 0,
              "maximum": 1000000000.0,
              "title": "Minimum Damage",
              "type": "number"
            },
            "interval_seconds": {
              "default": 1,
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "title": "Interval Seconds",
              "type": "number"
            },
            "first_hit_seconds": {
              "default": 0,
              "maximum": 3600,
              "minimum": 0,
              "title": "First Hit Seconds",
              "type": "number"
            }
          },
          "required": [
            "hp",
            "attack"
          ],
          "title": "CombatSpec",
          "type": "object"
        }
      },
      "properties": {
        "spec": {
          "$ref": "#/$defs/CombatSpec"
        }
      },
      "required": [
        "spec"
      ],
      "title": "calculate_combatArguments",
      "type": "object"
    },
    "outputSchema": null,
    "icons": null,
    "annotations": null,
    "meta": null,
    "execution": null
