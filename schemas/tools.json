            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirm Revision"
        }
      },
      "required": [
        "session",
        "answers"
      ],
      "title": "advance_design_interviewArguments",
      "type": "object"
    },
    "outputSchema": null,
