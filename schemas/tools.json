                  "maxLength": 6000,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Locator"
            }
          },
          "required": [
            "id",
            "topic",
            "question",
            "recommendation"
          ],
          "title": "Decision",
          "type": "object"
        },
        "DesignAnswer": {
          "additionalProperties": false,
          "properties": {
            "decision_id": {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "title": "Decision Id",
              "type": "string"
            },
            "answer": {
              "maxLength": 6000,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Answer",
              "type": "string"
            },
            "basis": {
              "enum": [
                "user",
                "project_evidence",
                "hypothesis"
              ],
              "title": "Basis",
              "type": "string"
            },
            "locator": {
              "anyOf": [
                {
                  "maxLength": 6000,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Locator"
            }
          },
          "required": [
            "decision_id",
            "answer",
            "basis"
          ],
          "title": "DesignAnswer",
          "type": "object"
        },
        "DesignSession": {
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "title": "Session Id",
              "type": "string"
            },
            "revision": {
              "default": 1,
              "minimum": 1,
              "title": "Revision",
              "type": "integer"
            },
            "original_request": {
              "maxLength": 6000,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Original Request",
              "type": "string"
            },
            "decisions": {
              "items": {
                "$ref": "#/$defs/Decision"
              },
