              "type": "array"
            },
            "confirmed_revision": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Confirmed Revision"
            },
            "explore_assumptions": {
              "default": false,
              "title": "Explore Assumptions",
